{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true,
    "noEmit": true, "types": ["vite/client", "node"], "isolatedModules": true
  },
  "include": ["src", "api", "tests", "vite.config.ts", "vitest.config.ts"]
}
